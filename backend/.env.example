# ─────────────────────────────────────────────────────────────────────────────
# PRINTEX BACKEND — environment template
#
# Copy this file to `.env` in the same folder and fill in what you need:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
#
# Only the DATABASE and JWT sections are required to boot the app. Everything
# else (M-Pesa, SMS, email, storage) can stay blank during local development —
# those features simply stay switched off until you add credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Printex Engineers
APP_ENV=development
DEBUG=True

# Signs session data. Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy

# Which origins the browser may call the API from. Comma-separated, no spaces.
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# When running under Docker Compose, the host is `db` (the service name) and
# docker-compose.yml overrides these anyway.
# When running the backend directly on your machine, use `localhost`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/printex_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/printex_db

# ── Redis ────────────────────────────────────────────────────────────────────
# Under Docker the host is `redis`; bare-metal it is `localhost`.
REDIS_URL=redis://localhost:6379/0

# ── JWT (REQUIRED) ───────────────────────────────────────────────────────────
# Must differ from SECRET_KEY. Generate the same way.
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google Sign-In (optional) ────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend .env.local exactly.
GOOGLE_CLIENT_ID=

# ── M-Pesa Daraja (optional — needed for payments) ───────────────────────────
# developer.safaricom.co.ke → create an app → Lipa Na M-Pesa Online.
# Sandbox shortcode 174379 works with the sandbox test credentials.
# CALLBACK_URL must be a PUBLIC https URL — Safaricom cannot reach localhost.
# Use ngrok during development:  ngrok http 8000
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-ngrok-id.ngrok-free.app/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# ── Flutterwave card payments (optional) ─────────────────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=

# ── Africa's Talking SMS (optional) ──────────────────────────────────────────
# Leave AT_USERNAME as `sandbox` while testing.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=PRINTEX

# ── Resend email (optional) ──────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@printex.co.ke

# ── Cloudflare R2 image storage (optional) ───────────────────────────────────
# Without these, image uploads fail but the rest of the app runs fine.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=printex-media
R2_PUBLIC_URL=

# ── Groq AI assistant (optional) ─────────────────────────────────────────────
# console.groq.com — free tier is generous.
GROQ_API_KEY=

# Admin AI assistant (director/secretary/super_admin only) — see
# app/admin_ai/. Reuses GROQ_API_KEY above for the Groq option.
XAI_API_KEY=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
