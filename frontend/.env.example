# ─────────────────────────────────────────────────────────────────────────────
# PRINTEX FRONTEND — environment template
#
# Copy to `.env.local`:   cp .env.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is embedded into the JavaScript sent to the
# browser. Never put a secret here — treat these as public.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser reaches the API. Leave this as localhost (or unset) for
# multi-device use on a LAN — the frontend automatically detects the host
# each browser used to load the page (e.g. a phone that opened
# http://192.168.1.50:3000 will call http://192.168.1.50:8000/api/v1 on its
# own) so every laptop and phone on the network can use the system without
# per-device configuration. Only override this with a real domain when
# deploying to production behind a fixed hostname.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional — must match GOOGLE_CLIENT_ID in backend/.env exactly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
