# ─────────────────────────────────────────────────────────────────────────────
# PRINTEX FRONTEND — environment template
#
# Copy to `.env.local`:   cp .env.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is embedded into the JavaScript sent to the
# browser. Never put a secret here — treat these as public.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser reaches the API. Must be localhost even when running under
# Docker, because this URL is resolved by the user's browser, not the container.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional — must match GOOGLE_CLIENT_ID in backend/.env exactly.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
